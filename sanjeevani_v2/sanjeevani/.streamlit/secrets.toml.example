# Copy this file to .streamlit/secrets.toml and fill it in.
# secrets.toml is in .gitignore so it will NOT be pushed to GitHub.

# AI (NVIDIA NIM, free key from build.nvidia.com)
NVIDIA_API_KEY = "nvapi-paste-your-key-here"
NVIDIA_MODEL = "meta/llama-3.2-11b-vision-instruct"

# Family contacts (can also be typed in the sidebar)
SOS_CONTACTS = "Suresh:+919876543210"

# FREE real SMS from an Android phone (SMS Gateway for Android app, Cloud mode)
SMSGATE_USER = "username-shown-in-the-app"
SMSGATE_PASS = "password-shown-in-the-app"

# FREE loud alarm on family phones (ntfy app, subscribe to this topic)
NTFY_TOPIC = "sanjeevani-sos-pick-long-secret-words"

# Optional, paid/trial: automatic phone calls (Twilio)
# TWILIO_ACCOUNT_SID = "AC..."
# TWILIO_AUTH_TOKEN = "..."
# TWILIO_FROM_NUMBER = "+1..."
